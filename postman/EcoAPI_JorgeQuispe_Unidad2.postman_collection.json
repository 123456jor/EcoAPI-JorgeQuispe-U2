            "id": "abc11000-c5c8-4580-ad4f-8f39ce94b193",
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const p=pm.response.json();pm.collectionVariables.set(\"punto1\",p.contenido[0].id);pm.collectionVariables.set(\"punto2\",p.contenido[1].id);pm.test(\"Envoltorio y filtro\",()=>{pm.expect(p.contenido).to.have.length(2);pm.expect(p.totalElementos).to.be.at.least(4);pm.expect(p.ultima).to.be.false;pm.expect(p.contenido.every(x=>x.zona===\"Norte\")).to.be.true;});"
            ],
            "_lastExecutionId": "7917c1c4-a97c-414d-b597-e4c43b965e79"
          }
        }
      ]
